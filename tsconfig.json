{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "allowJs": true,
    "baseUrl": "./src",
    "typeRoots": ["./types"],
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
